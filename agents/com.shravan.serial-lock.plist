<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.{{USERNAME}}serial-lock</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>until [ -d {{SSD_MOUNT}} ]; do sleep 5; done; {{SSD_MOUNT}}/Dev/scripts/ssd-tools/6-serial-lock.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/serial-lock.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/serial-lock.log</string>
	<key>WatchPaths</key>
	<array>
		<string>{{SSD_MOUNT}}</string>
	</array>
</dict>
</plist>
