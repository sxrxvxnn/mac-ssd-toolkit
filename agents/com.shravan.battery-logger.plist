<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.{{USERNAME}}battery-logger</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>{{SSD_MOUNT}}/Dev/scripts/ssd-tools/19-battery-logger.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/battery-logger.log</string>
  <key>StandardErrorPath</key><string>/tmp/battery-logger.log</string>
</dict>
</plist>
